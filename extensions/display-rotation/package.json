{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "display-rotation",
  "title": "Display Rotation",
  "description": "Rotate any connected display from Raycast with displayplacer. Screens and layouts are discovered, nothing is configured.",
  "icon": "extension-icon.png",
  "author": "dworznik",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "rotate-display",
      "title": "Rotate Display",
      "subtitle": "displayplacer",
      "description": "Lists the connected displays and rotates the one you pick.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "displayplacerPath",
      "type": "textfield",
      "required": false,
      "default": "/opt/homebrew/bin/displayplacer",
      "title": "displayplacer Path",
      "description": "Path to the displayplacer binary."
    }
  ],
  "dependencies": {
    "@raycast/api": "catalog:",
    "@raycast/utils": "catalog:",
    "react": "catalog:"
  },
  "scripts": {
    "build": "ray build",
    "dist": "ray build -e dist -o dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "publish": "npx @raycast/api@latest publish"
  },
  "devDependencies": {
    "@raycast/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
