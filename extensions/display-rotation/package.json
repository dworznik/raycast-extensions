{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "display-rotation",
  "title": "Display Rotation",
  "description": "Rotate any connected display from Raycast with displayplacer. Screens and layouts are discovered, nothing is configured.",
  "icon": "extension-icon.png",
  "author": "dworznik",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "rotate-display",
      "title": "Rotate Display",
      "subtitle": "displayplacer",
      "description": "Rotates a connected display. Name a screen or leave it empty for the external one, and pick a rotation or leave it empty to toggle.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "screen",
          "type": "text",
          "placeholder": "Screen",
          "required": false
        },
        {
          "name": "rotation",
          "type": "dropdown",
          "placeholder": "Rotation",
          "required": false,
          "data": [
            {
              "title": "Natural",
              "value": "0"
            },
            {
              "title": "90°",
              "value": "90"
            },
            {
              "title": "180°",
              "value": "180"
            },
            {
              "title": "270°",
              "value": "270"
            }
          ]
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "displayplacerPath",
      "type": "textfield",
      "required": false,
      "default": "/opt/homebrew/bin/displayplacer",
      "title": "displayplacer Path",
      "description": "Path to the displayplacer binary."
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.1"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "publish": "npx @raycast/api@latest publish"
  }
}
