{
  "name": "raycast-extensions",
  "private": true,
  "description": "My Raycast extensions, one self-contained extension per directory in a pnpm workspace.",
  "license": "MIT",
  "author": "dworznik",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "fix-lint": "pnpm -r run fix-lint",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@raycast/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
